+#include "CarMotionLink.h"
+
+#include "Config/CarConfig.h"
+#include "MotionPlanner.h"
+#include "ti_msp_dl_config.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define CAR_MOTION_FRAME_SIZE        (9U)
+#define CAR_MOTION_FRAME_HEAD_0      (0xA5U)
+#define CAR_MOTION_FRAME_HEAD_1      (0x5AU)
+
+/*
+ * µ¥¸ö×Ö½ÚµÈ´ı·¢ËÍµÄ×î´óÑ­»·´ÎÊı¡£
+ *
+ * UARTÒì³£Ê±Ö±½Ó·ÅÆúµ±Ç°Ö¡£¬²»ÄÜ³¤ÆÚ×èÈû³µÁ¾¿ØÖÆ¡£
+ */
+#define CAR_MOTION_TX_WAIT_LOOPS     (20000U)
+
+static uint8_t g_sequence;
+static uint32_t g_lastSendMs;
+static uint32_t g_txDropCount;
+
+static void WriteI16(uint8_t *out, int32_t value)
+{
+    uint16_t raw;
+
+    if (value > 32767)
+    {
+        value = 32767;
+    }
+    else if (value < -32768)
+    {
+        value = -32768;
+    }
+
+    raw = (uint16_t)(int16_t)value;
+
+    /*
+     * Ğ­ÒéÊ¹ÓÃĞ¡¶Ë¸ñÊ½¡£
+     */
+    out[0] = (uint8_t)raw;
+    out[1] = (uint8_t)(raw >> 8U);
+}
+
+static uint8_t CalculateChecksum(const uint8_t *frame)
+{
+    uint8_t checksum = 0U;
+    uint8_t index;
+
+    for (index = 0U; index < 8U; index++)
+    {
+        checksum = (uint8_t)(checksum + frame[index]);
+    }
+
+    return checksum;
+}
+
+static bool SendByte(uint8_t value)
+{
+    uint32_t waitLoops = CAR_MOTION_TX_WAIT_LOOPS;
+
+    while (!DL_UART_Main_transmitDataCheck(
+                UART_1_INST,
+                value))
+    {
+        if (waitLoops == 0U)
+        {
+            return false;
+        }
+
+        waitLoops--;
+    }
+
+    return true;
+}
+
+static bool SendFrame(const uint8_t *frame)
+{
+    uint8_t index;
+
+    for (index = 0U;
+         index < CAR_MOTION_FRAME_SIZE;
+         index++)
+    {
+        if (!SendByte(frame[index]))
+        {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+void CarMotionLink_Init(uint32_t nowMs)
+{
+    g_sequence = 0U;
+    g_lastSendMs = nowMs;
+    g_txDropCount = 0U;
+}
+
+void CarMotionLink_Task(
+    uint32_t nowMs,
+    bool ready,
+    bool running,
+    bool emergency,
+    bool balanceMode)
+{
+    MotionPlannerStatus_t motion;
+    uint8_t frame[CAR_MOTION_FRAME_SIZE];
+    uint8_t flags = 0U;
+
+    if ((uint32_t)(nowMs - g_lastSendMs) <
+        CAR_MOTION_LINK_PERIOD_MS)
+    {
+        return;
+    }
+
+    /*
+     * ±£³Ö·¢ËÍÖÜÆÚÎÈ¶¨¡£
+     */
+    g_lastSendMs += CAR_MOTION_LINK_PERIOD_MS;
+
+    /*
+     * Èç¹ûÖ÷Ñ­»·ÑÓ³ÙÌ«¾Ã£¬Ôò´Óµ±Ç°Ê±¼äÖØĞÂ¼ÆÊ±£¬
+     * ²»Á¬Ğø²¹·¢´óÁ¿¾ÉÖ¡¡£
+     */
+    if ((uint32_t)(nowMs - g_lastSendMs) >=
+        CAR_MOTION_LINK_PERIOD_MS)
+    {
+        g_lastSendMs = nowMs;
+    }
+
+    motion = MotionPlanner_GetStatus();
+
+    /*
+     * ½ô¼±×´Ì¬ÓµÓĞ×î¸ßÓÅÏÈ¼¶¡£
+     *
+     * EMERGENCYÓĞĞ§Ê±£¬²»ÔÙÍ¬Ê±·¢ËÍREADY»òRUNNING£¬
+     * ±ÜÃâ¸ËÇò°åÊÕµ½»¥ÏàÃ¬¶ÜµÄ¿ØÖÆ×´Ì¬¡£
+     */
+    if (emergency)
+    {
+        flags = CAR_MOTION_FLAG_EMERGENCY;
+    }
+    else if (running)
+    {
+        flags = CAR_MOTION_FLAG_RUNNING;
+    }
+    else if (ready)
+    {
+        flags = CAR_MOTION_FLAG_READY;
+    }
+    else
+    {
+        flags = 0U;
+    }
+
+    if (balanceMode)
+    {
+        flags |= CAR_MOTION_FLAG_BALANCE_MODE;
+    }
+
+    frame[0] = CAR_MOTION_FRAME_HEAD_0;
+    frame[1] = CAR_MOTION_FRAME_HEAD_1;
+    frame[2] = g_sequence++;
+    frame[3] = flags;
+
+    WriteI16(
+        &frame[4],
+        motion.plannedCps
+    );
+
+    WriteI16(
+        &frame[6],
+        motion.accelerationMmS2
+    );
+
+    frame[8] = CalculateChecksum(frame);
+
+    if (!SendFrame(frame))
+    {
+        g_txDropCount++;
+    }
 }
